{
    "name": "client",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@cosmjs/crypto": "^0.38.1",
        "@noble/curves": "^1.4.0",
        "@noble/hashes": "^2.0.1",
        "@noble/secp256k1": "^2.0.0",
        "@scure/bip32": "^1.4.0",
        "@solana/spl-token": "^0.4.9",
        "@solana/web3.js": "^1.98.0",
        "bech32": "^2.0.0",
        "bip39": "^3.1.0",
        "buffer": "^6.0.3",
        "crypto-browserify": "^3.12.0",
        "crypto-js": "^4.2.0",
        "hls.js": "^1.5.7",
        "process": "^0.11.10",
        "react": "^19.2.3",
        "react-app-rewired": "^2.2.1",
        "react-dom": "^19.2.3",
        "react-helmet-async": "^2.0.5",
        "react-icons": "^5.6.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^6.2.1",
        "react-scripts": "^5.0.1",
        "remark-gfm": "^4.0.1",
        "stream-browserify": "^3.0.0",
        "styled-components": "^5.3.3",
        "unist-util-visit": "^5.0.0"
    },
    "scripts": {
        "start": "sh -c 'GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo \"?\"); GIT_HASH=$(git rev-parse --short HEAD 2>/dev/null || echo \"?\"); export REACT_APP_VERSION=\"${GIT_BRANCH} (${GIT_HASH})\"; BROWSER=none react-app-rewired start'",
        "build": "sh -c 'GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo \"?\"); GIT_HASH=$(git rev-parse --short HEAD 2>/dev/null || echo \"?\"); export REACT_APP_VERSION=\"${GIT_BRANCH} (${GIT_HASH})\"; react-app-rewired build'",
        "lint": "eslint src --ext .js,.jsx",
        "eject": "react-scripts eject"
    },
    "eslintConfig": {
        "extends": [
            "react-app"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
        "react-error-overlay": "^6.0.9"
    },
    "overrides": {
        "mdast-util-find-and-replace": "^3.0.0",
        "nth-check": "^2.1.1"
    },
    "proxy": "http://localhost:80"
}
