# Deployment mode: "main" for production, "local" for development
MIRAGE_MODE=main

# Backend server bind address (use 127.0.0.1 for reverse proxy, 0.0.0.0 for direct)
BACKEND_HOST=127.0.0.1

# Backend server port
BACKEND_PORT=5000

# Number of Gunicorn worker processes (leave empty for auto based on CPU cores)
GUNICORN_WORKERS=

# Note: Cloudflare credentials are configured in secrets.env
# (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_HASH, CLOUDFLARE_STREAM_CUSTOMER_CODE)
