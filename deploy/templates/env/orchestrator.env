# Bridge Orchestrator
#
# The orchestrator relays bridge transactions between Mirage and 
# other coins such as Solana (but not IBC). It uses your validator's 
# Mirage key and a separate Solana wallet.
#
# Copy to ~/.mirage/env/orchestrator.env

# Enable/disable orchestrator
ORCHESTRATOR_ENABLED=true

# Solana bridge program (get from bridge admin)
ORCHESTRATOR_SOLANA_PROGRAM_ID=BRidGeProgramAddressXXXXXXXXXXXXXXXXXXXXXXX

# Solana RPC endpoints
ORCHESTRATOR_SOLANA_RPC=https://api.mainnet-beta.solana.com
ORCHESTRATOR_SOLANA_WS=wss://api.mainnet-beta.solana.com

# Solana wallet - run ./deploy/setup_orchestrator.sh to import from mnemonic
# Fund the address with ~0.1 SOL for transaction fees
ORCHESTRATOR_SOLANA_KEYPAIR=${HOME}/.mirage/orchestrator/solana-keypair.json

# Solana confirmation settings
ORCHESTRATOR_SOLANA_CONFIRMATIONS=32
ORCHESTRATOR_SOLANA_POLL_INTERVAL=5s

# Mirage node endpoints (localhost = same machine)
ORCHESTRATOR_MIRAGE_GRPC=127.0.0.1:9090
ORCHESTRATOR_MIRAGE_RPC=http://127.0.0.1:26657
ORCHESTRATOR_MIRAGE_GAS_LIMIT=200000
ORCHESTRATOR_MIRAGE_FEE_AMOUNT=1000

# Mirage keyring - uses validator's existing key at ~/.mirage/node
ORCHESTRATOR_KEYRING_BACKEND=test
ORCHESTRATOR_KEY_NAME=validator

# Attestor batching
ORCHESTRATOR_BATCH_SIZE=10
ORCHESTRATOR_RETRY_INTERVAL=10s
ORCHESTRATOR_MAX_RETRIES=5
