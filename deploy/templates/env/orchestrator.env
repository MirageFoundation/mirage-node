# Bridge Orchestrator
#
# The orchestrator relays bridge transactions between Mirage and 
# other coins such as Solana (but not IBC). It uses your validator's 
# Mirage key and a separate Solana wallet.
#
# Copy to ~/.mirage/env/orchestrator.env

# Enable/disable orchestrator
ORCHESTRATOR_ENABLED=true

# Mirage node endpoints (localhost = same machine)
ORCHESTRATOR_MIRAGE_GRPC=127.0.0.1:9090
ORCHESTRATOR_MIRAGE_RPC=http://127.0.0.1:26657
ORCHESTRATOR_MIRAGE_GAS_LIMIT=200000
ORCHESTRATOR_MIRAGE_FEE_AMOUNT=1000

# Mirage keyring - uses validator's existing key at ~/.mirage/node
ORCHESTRATOR_KEYRING_BACKEND=test
ORCHESTRATOR_KEY_NAME=validator

# Attestor batching
ORCHESTRATOR_BATCH_SIZE=10
ORCHESTRATOR_RETRY_INTERVAL=10s
ORCHESTRATOR_MAX_RETRIES=5

# Solana bridge program
# DEVNET:  2Qq27EibjxwgaV69WJst2Wxj3TS33DSVV42Gys9pDV8V
# MAINNET: (not deployed yet)
ORCHESTRATOR_SOLANA_PROGRAM_ID=2Qq27EibjxwgaV69WJst2Wxj3TS33DSVV42Gys9pDV8V

# Solana RPC endpoints
# DEVNET:  https://api.devnet.solana.com / wss://api.devnet.solana.com
# MAINNET: https://api.mainnet-beta.solana.com / wss://api.mainnet-beta.solana.com
ORCHESTRATOR_SOLANA_RPC=https://api.devnet.solana.com
ORCHESTRATOR_SOLANA_WS=wss://api.devnet.solana.com

# Solana wallet - run: python3 deploy/setup_orchestrator.py
# Fund the address with ~0.1 SOL for transaction fees
ORCHESTRATOR_SOLANA_KEYPAIR=${HOME}/.mirage/orchestrator/solana-keypair.json

# Solana confirmation settings
ORCHESTRATOR_SOLANA_CONFIRMATIONS=32
ORCHESTRATOR_SOLANA_POLL_INTERVAL_MIN=30s
ORCHESTRATOR_SOLANA_POLL_INTERVAL_MAX=45s

# Rent reclamation - closes old MintRecords to recover ~0.00383 SOL each
# Runs once at startup, then at this interval. Set to 0 to disable.
# Supports: 30s, 5m, 1h, 6h, 1d, etc.
ORCHESTRATOR_SOLANA_CLEANUP_INTERVAL=1h
# Minimum age before a completed record can be closed (default: 24h)
# Security note: MintRecords provide replay protection. Only reduce if you trust
# your orchestrator won't re-process old burns. Supports: 1h, 12h, 1d, 7d, etc.
ORCHESTRATOR_SOLANA_CLEANUP_MIN_AGE=1h
