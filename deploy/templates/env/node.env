# Node identity (displayed in block explorers and peer lists)
# If DOMAIN is set below, this is ignored and MONIKER becomes "https://{DOMAIN}"
MONIKER=validator

# Domain for HTTPS/TLS (e.g., "mirage.vote")
# - Used for Caddy SSL certificates  
# - Overrides MONIKER to "https://{DOMAIN}"
# Leave empty for HTTP-only deployments (uses MONIKER above)
DOMAIN=

# Skip DNS-to-IP validation during HTTPS setup (e.g. behind Cloudflare Proxy).
# Set to "true" when the domain resolves to a proxy IP instead of this server's IP.
SKIP_HTTPS_IP_CHECK=false

# Persistent peers (comma-separated node_id@host:port)
PERSISTENT_PEERS=5fe7efb829e75ae8518faee424d6871b7f66714a@159.203.114.27:26656,b51a4505b20b9a555e3712ed67089762ec934ddf@64.23.136.132:26656,9517122294159cd191e82439d4f9e2b88185a608@146.190.108.140:26656,765ad58fd849498c1f45a3c402da6d51029640f1@139.59.9.96:26656

# Enable peer exchange protocol for automatic peer discovery (true/false)
PEX_ENABLED=true

# Maximum number of incoming peer connections to accept
MAX_INBOUND_PEERS=40

# Maximum number of outgoing peer connections to initiate
MAX_OUTBOUND_PEERS=10

# Skip upgrades that weren't triggered via governance (comma-separated)
# Use this for dev/UAT when deploying new binaries before submitting upgrade proposals
# Example: SKIP_UPGRADES=v1.9.3-bridge-fee-burn,v1.9.4-bridge-attestor-fix
SKIP_UPGRADES=

# CometBFT block retention (in blocks)
# How many recent blocks to keep for /block, /tx, /commit RPC queries.
# 201600 blocks = 7 days at 3s/block
RETENTION_BLOCKS=201600

# IAVL state version retention (in blocks)
# How many recent IAVL tree versions to keep for historical gRPC state queries.
# Keep this LOW — the indexer/backend only need current state, not history.
# 1000 blocks ≈ 50 min at 3s/block. Each extra version costs real disk.
PRUNING_KEEP_RECENT=1000

# Pruning cadence (in blocks)
# 100 blocks = ~5 minutes at 3s/block
PRUNING_INTERVAL=100

# State sync snapshot interval (in blocks)
# 14400 blocks = 24 hours at 6s/block
SNAPSHOT_INTERVAL=14400

# State sync snapshot retention (count)
# Total snapshot window = SNAPSHOT_INTERVAL * SNAPSHOT_KEEP_RECENT
# 14400 * 2 = 28800 blocks = 48 hours of state-sync availability
SNAPSHOT_KEEP_RECENT=2

# Log file retention (days)
# Log files older than this are deleted daily. Applies to all services.
LOG_RETENTION_DAYS=30

# Database backends (goleveldb or pebbledb)
# Changed by scripts/migrate_pebbledb.py — do not edit manually
APP_DB_BACKEND=pebbledb
COMET_DB_BACKEND=pebbledb

# State-sync configuration (set by scripts/migrate_pebbledb.py during migration
# or by scripts/recover.sh state-sync during automatic divergence recovery)
STATESYNC_ENABLE=false
STATESYNC_RPC_SERVERS=
STATESYNC_TRUST_HEIGHT=0
STATESYNC_TRUST_HASH=

# Auto-recovery from app-hash divergence (true/false). When enabled, the
# entrypoint launches scripts/divergence_watchdog.py in a tmux 'watchdog'
# window. The watchdog detects "wrong Block.Header.AppHash" / "CONSENSUS
# FAILURE!!!" in miraged logs (or a multi-poll stall vs healthy peers) and
# invokes scripts/recover.sh peer-pull to wipe chain DBs and pull a snapshot
# from a healthy peer. priv_validator_state.json is preserved (no double-sign).
# Cool-down: 6h between auto-recoveries. Disable per-run by creating
# /root/.mirage/.recovery_disabled inside the container.
AUTO_DIVERGENCE_RECOVERY=true

# When true, the watchdog logs detected divergences but does NOT run the
# recovery script. Use during the first soak period on a new deployment to
# validate detection without risk.
DIVERGENCE_DRY_RUN=false
