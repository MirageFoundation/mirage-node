# Node identity (displayed in block explorers and peer lists)
# If DOMAIN is set below, this is ignored and MONIKER becomes "https://{DOMAIN}"
MONIKER=validator

# Domain for HTTPS/TLS (e.g., "mirage.vote")
# - Used for Caddy SSL certificates  
# - Overrides MONIKER to "https://{DOMAIN}"
# Leave empty for HTTP-only deployments (uses MONIKER above)
DOMAIN=

# Skip DNS-to-IP validation during HTTPS setup (e.g. behind Cloudflare Proxy).
# Set to "true" when the domain resolves to a proxy IP instead of this server's IP.
SKIP_HTTPS_IP_CHECK=false

# Persistent peers (comma-separated node_id@host:port)
PERSISTENT_PEERS=5fe7efb829e75ae8518faee424d6871b7f66714a@159.203.114.27:26656,b51a4505b20b9a555e3712ed67089762ec934ddf@64.23.136.132:26656,9517122294159cd191e82439d4f9e2b88185a608@146.190.108.140:26656,765ad58fd849498c1f45a3c402da6d51029640f1@139.59.9.96:26656

# Enable peer exchange protocol for automatic peer discovery (true/false)
PEX_ENABLED=true

# Maximum number of incoming peer connections to accept
MAX_INBOUND_PEERS=40

# Maximum number of outgoing peer connections to initiate
MAX_OUTBOUND_PEERS=10

# Skip upgrades that weren't triggered via governance (comma-separated)
# Use this for dev/UAT when deploying new binaries before submitting upgrade proposals
# Example: SKIP_UPGRADES=v1.9.3-bridge-fee-burn,v1.9.4-bridge-attestor-fix
SKIP_UPGRADES=

# CometBFT block retention (in blocks)
# How many recent blocks to keep for /block, /tx, /commit RPC queries.
# 201600 blocks = 7 days at 3s/block
RETENTION_BLOCKS=201600

# IAVL state version retention (in blocks)
# How many recent IAVL tree versions to keep for historical gRPC state queries.
# Keep this LOW — the indexer/backend only need current state, not history.
# 1000 blocks ≈ 50 min at 3s/block. Each extra version costs real disk.
PRUNING_KEEP_RECENT=1000

# Pruning cadence (in blocks)
# 100 blocks = ~5 minutes at 3s/block
PRUNING_INTERVAL=100

# State sync snapshot interval (in blocks)
# 14400 blocks = 24 hours at 6s/block
SNAPSHOT_INTERVAL=14400

# State sync snapshot retention (count)
# Total snapshot window = SNAPSHOT_INTERVAL * SNAPSHOT_KEEP_RECENT
# 14400 * 2 = 28800 blocks = 48 hours of state-sync availability
SNAPSHOT_KEEP_RECENT=2

# Log file retention (days)
# Log files older than this are deleted daily. Applies to all services.
LOG_RETENTION_DAYS=30

# Database backends (goleveldb or pebbledb)
# Changed by scripts/migrate_pebbledb.py — do not edit manually
APP_DB_BACKEND=pebbledb
COMET_DB_BACKEND=pebbledb

# State-sync configuration (set by scripts/migrate_pebbledb.py during migration
# or by scripts/recover.sh state-sync during automatic divergence recovery)
STATESYNC_ENABLE=false
STATESYNC_RPC_SERVERS=
STATESYNC_TRUST_HEIGHT=0
STATESYNC_TRUST_HASH=

# Divergence watchdog — two-tier recovery (updated after the 2026-06-14 stall).
#
# There are two gates, and they now mean different things:
#
#   AUTO_DIVERGENCE_RECOVERY=true  → run the watchdog process at all. This is
#       now the DEFAULT ON every validator. The watchdog's first-line action is
#       a NON-DESTRUCTIVE process restart (recover.sh restart), which cannot
#       brick the validator set, so running it everywhere is safe and means a
#       stuck/crashed node self-heals on every host — not just mirage.talk.
#
#   WATCHDOG_AUTORECOVER=true      → additionally permit DESTRUCTIVE recovery
#       (recover.sh peer-pull, which wipes and re-pulls chain DBs). This stays
#       OPT-IN per host and should remain on exactly ONE host (mirage.talk).
#       Restart never needs this gate; only state divergence does.
#
# Why the split: on 2026-05-27 a default-on DESTRUCTIVE watchdog mistook a
# benign upgrade halt for divergence and wiped 3 of 4 chain DBs. Restart is
# harmless by comparison, so it is ungated; peer-pull stays gated and single-
# host. On 2026-06-14 a stuck consensus reactor (local app_hash matched peers)
# needed only a restart, but the old watchdog had no restart action.
#
# Escalation ladder (see scripts/divergence_watchdog.py):
#   log-pattern divergence   -> peer-pull            (gated)
#   stall + app_hash MATCH   -> restart              (ungated, non-destructive)
#   stall + app_hash MISS    -> peer-pull            (gated)
#   process-dead             -> restart, then        (restart ungated;
#                               peer-pull if it          peer-pull gated)
#                               fails to recover
#   3 restarts within 2h     -> peer-pull            (recurrence escalation)
#
# BEHAVIOR CHANGE on mirage.vote / 146.190.108.140 / 139.59.9.96: previously no
# watchdog ran, so a crashed/stuck miraged needed manual intervention. Now those
# hosts auto-RESTART miraged (non-destructive) on a stall or process-dead
# trigger. They will NOT peer-pull (WATCHDOG_AUTORECOVER stays false). A
# simultaneous network-wide restart is structurally impossible: the stall
# trigger requires peers to be strictly ahead, which cannot hold for every node
# at once.
#
# Operating policy:
#   - mirage.talk:        AUTO_DIVERGENCE_RECOVERY=true, WATCHDOG_AUTORECOVER=true
#                         (full recovery; peer-pull REQUIRES the recovery key —
#                         run `recover.sh provision` first. If the key is
#                         missing, the watchdog logs ALERT and continues
#                         restart-only; destructive peer-pull is disabled until
#                         the key exists.)
#   - all other hosts:    AUTO_DIVERGENCE_RECOVERY=true, WATCHDOG_AUTORECOVER=false
#                         (restart-only; set per host in /root/.mirage/env/node.env
#                         to opt out by flipping AUTO_DIVERGENCE_RECOVERY=false).
#
# Safety guards the watchdog always respects:
#   - restart cool-down  /root/.mirage/.restart_recovery_lock (15m, restart only)
#   - destructive cool-down /root/.mirage/.divergence_recovery_lock (6h; written
#     ONLY by recover.sh after a verified peer-pull — never by the watchdog)
#   - opt-out marker     /root/.mirage/.recovery_disabled
#   - >=2 healthy peers with agreeing app_hash (delegated to recover.sh peer-pull)
#
# Forensic logging: every poll is written to
# /root/.mirage/logs/watchdog/watchdog-YYYY-MM-DD.log (90-day retention) with
# tagged, greppable lines (POLL/PEER/GATE/TRIGGER/PRECHECK/DISPATCH/INVOKE/
# POSTCHECK/COOLDOWN/ESCALATE/ALERT/CRASH/STARTUP/SHUTDOWN).
#
# The template default below enables restart-only recovery everywhere. The
# deploy overlay flips WATCHDOG_AUTORECOVER=true on mirage.talk.
AUTO_DIVERGENCE_RECOVERY=true
WATCHDOG_AUTORECOVER=false

# Legacy DRY_RUN gate, kept for back-compat. true ⇒ never invoke recover.sh
# (same effect as WATCHDOG_AUTORECOVER=false, lower precedence).
DIVERGENCE_DRY_RUN=false
