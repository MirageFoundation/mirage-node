# ── Database ────────────────────────────────────────────────────────────────

# Read-only connection to the indexer DB (used by backend — never writes to indexer tables)
INDEXER_DB_RO_URL=postgresql://mirage_ro:mirage_ro@127.0.0.1:5432/mirage

# Backend-owned DB for quests, invites, referrals, stats, reports, push, similarity
BACKEND_DB_URL=postgresql://mirage:mirage@127.0.0.1:5432/mirage_backend

# ── Server ──────────────────────────────────────────────────────────────────

# Backend server bind address (use 127.0.0.1 for reverse proxy, 0.0.0.0 for direct)
BACKEND_HOST=127.0.0.1

# Backend server port
BACKEND_PORT=5000

# Backend debug endpoints - set to "true" to enable (localhost only)
BACKEND_DEBUG=false

# Number of Gunicorn worker processes (leave empty for auto based on CPU cores)
BACKEND_GUNICORN_WORKERS=

# ── Registration ────────────────────────────────────────────────────────────

# Account registration - set to "true" to allow new account creation on this node
REGISTRATION_ENABLED=false

# Invite code requirement - set to "true" to require invite codes for new account registration
REGISTRATION_INVITE_CODE_REQUIRED=false

# ── Quests ──────────────────────────────────────────────────────────────────

# Quest system - set to "true" to enable quests UI for all users
QUESTS_ENABLED=false

# Number of daily quests assigned to each user per day
QUESTS_DAILY_COUNT=2

# Number of flash quests a user can have active at once
QUESTS_FLASH_COUNT=1

# Flash quest cooldown interval (random between min and max hours)
QUESTS_FLASH_MIN_INTERVAL_HOURS=5
QUESTS_FLASH_MAX_INTERVAL_HOURS=7

# Probability that the invite_recruit quest is offered (0.0 to 1.0)
QUESTS_INVITE_RECRUIT_CHANCE=0.30

# How many completed quests before the invite_earner quest can appear
QUESTS_INVITE_EARNER_INTERVAL=10

# Probability that the invite_earner quest is offered (0.0 to 1.0)
QUESTS_INVITE_EARNER_CHANCE=0.30

# Quest reward payouts - set to "true" to enable actual token transfers
# Requires QUESTS_REWARDS_POOL_ADDRESS to be set
QUESTS_PAYOUTS_ENABLED=false

# Address of the rewards pool that holds tokens for quest reward distribution
QUESTS_REWARDS_POOL_ADDRESS=
