# ── Database ────────────────────────────────────────────────────────────────

# Read-only connection to the indexer DB (used by backend — never writes to indexer tables)
INDEXER_DB_RO_URL=postgresql://mirage_indexer_ro:mirage_indexer_ro@127.0.0.1:5432/mirage_indexer

# Backend-owned DB for quests, invites, referrals, stats, reports, push, similarity
BACKEND_DB_URL=postgresql://mirage_backend:mirage_backend@127.0.0.1:5432/mirage_backend

# ── Server ──────────────────────────────────────────────────────────────────

# Backend server bind address (use 127.0.0.1 for reverse proxy, 0.0.0.0 for direct)
BACKEND_HOST=127.0.0.1

# Backend server port
BACKEND_PORT=5000

# Backend debug endpoints - set to "true" to enable (localhost only)
BACKEND_DEBUG=false

# Number of Gunicorn worker processes (leave empty for auto based on CPU cores)
BACKEND_GUNICORN_WORKERS=

# How long startup may wait for the node to answer chain queries, in seconds.
# Must cover a coordinated chain upgrade: past the halt height the node cannot
# serve a height until 2/3+ of voting power is back on the new binary.
CHAIN_STARTUP_GRACE_SECONDS=1800

# ── Registration ────────────────────────────────────────────────────────────

# Account registration - set to "true" to allow new account creation on this node
REGISTRATION_ENABLED=true

# Invite code requirement - set to "true" to require invite codes for new account registration
REGISTRATION_INVITE_CODE_REQUIRED=false

# Open browsing - set to "true" to let logged-out visitors browse all content;
# account prompts then appear only on write/social actions (vote, comment, post, follow).
# Default open. Per-node migration pins mirage.vote/mirage.talk on and other existing nodes off.
OPEN_BROWSING_ENABLED=true

# Salt for client hash gating (set once by migration; backend fails hard if missing)
CLIENT_HASH_SALT=

# Grace period for POST /api/rewards/claim (YYYY-MM-DD UTC). Until this date a
# claim whose identity proof is missing OR fails verification is served and
# logged; after it, either returns 401. Mobile builds must ship signing before
# then. Existing nodes are moved off the original 2026-09-05 by the
# v1_32_3_extend_claim_grace_window migration.
LEGACY_UNSIGNED_UNTIL=2026-10-05

# ── Agents ──────────────────────────────────────────────────────────────────

# Comma-separated agent mirage1 addresses to serve as enabled for every user.
# Use commas between entries; spaces around commas are okay, plain spaces are not separators.
# Example: AUTO_ENABLED_AGENTS=mirage1abc...,mirage1def...
AUTO_ENABLED_AGENTS=

# ── Quests ──────────────────────────────────────────────────────────────────

# Quest system - set to "true" to enable quests UI for all users
QUESTS_ENABLED=false

# Number of daily quests assigned to each user per day
QUESTS_DAILY_COUNT=2

# Number of flash quests a user can have active at once
QUESTS_FLASH_COUNT=1

# Flash quest cooldown interval (random between min and max hours)
QUESTS_FLASH_MIN_INTERVAL_HOURS=5
QUESTS_FLASH_MAX_INTERVAL_HOURS=7

# Probability that the invite_recruit quest is offered (0.0 to 1.0)
# Set to 0 to disable referral bonuses (the 10k recruit/welcome payouts).
QUESTS_INVITE_RECRUIT_CHANCE=0

# How many completed quests before the invite_earner quest can appear
QUESTS_INVITE_EARNER_INTERVAL=10

# Probability that the invite_earner quest is offered (0.0 to 1.0)
# Set to 0 to disable referral bonuses (the 10k recruit/welcome payouts).
QUESTS_INVITE_EARNER_CHANCE=0

# Quest reward payouts - set to "true" to enable actual token transfers
# Requires QUESTS_REWARDS_POOL_ADDRESS to be set
QUESTS_PAYOUTS_ENABLED=false

# Address of the rewards pool that holds tokens for quest reward distribution
QUESTS_REWARDS_POOL_ADDRESS=

# ── Media providers ───────────────────────────────────────────────────────────

# Where user-uploaded media (images + video) is stored. All clients use the same
# uniform upload endpoint (POST /api/upload_media); the provider is hidden behind it.
#   local      - on this node's disk, served by Caddy at /media/* (no account)
#   cloudflare - Cloudflare Images/Stream (set CLOUDFLARE_* in secrets.env)
#   bunny      - Bunny Storage + Stream (set BUNNY_* in secrets.env)
MEDIA_PROVIDER=local

# Public media uploads. Must only be true where a scanning edge (Bunny Shield
# upload scanning) fronts uploads, so no unscanned media can reach the node. A
# node with no scanning edge (e.g. a self-hoster, or a node not yet behind Bunny)
# should set this false; the backend then returns 403 on /api/upload_media and the
# legacy /api/get_upload_url. Per-node migration manages this on the fleet.
MEDIA_UPLOADS_ENABLED=true

# Local provider: storage dir (empty = ~/.mirage/media) and public base URL
# (empty = serve relative "/media/..." from this same origin).
MEDIA_LOCAL_DIR=
MEDIA_PUBLIC_BASE_URL=

# Upload size caps (megabytes). MEDIA_MAX_VIDEO_MB covers a ~30-min 1080p clip
# (~1.5 GB raw). Keep Caddy's @upload max_size in the Caddyfile >= this value.
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=1500

# Video resolution policy: clips <= MEDIA_SHORT_CLIP_SEC may be any resolution
# (up to 4K); longer clips are capped at MEDIA_LONGFORM_MAX_HEIGHT (transcoding
# providers downscale; local rejects). MEDIA_VIDEO_MAX_DURATION_SEC is the hard cap
# (1800s = 30 min); long-form is 1080p, which keeps Bunny delivery cost bounded.
MEDIA_SHORT_CLIP_SEC=60
MEDIA_LONGFORM_MAX_HEIGHT=1080
MEDIA_VIDEO_MAX_DURATION_SEC=1800

# ── Media GC ──────────────────────────────────────────────────────────────────

# Delete unused media daily via the storing provider (view tracking always runs
# regardless). Set to "true" to enable actual deletion on this node.
IMAGE_GC_ENABLED=false
