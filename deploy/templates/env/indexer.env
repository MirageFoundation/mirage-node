# Enable or disable the blockchain indexer service (true/false)
INDEXER_ENABLED=true

# PostgreSQL connection URL for storing indexed blockchain data (indexer read-write)
INDEXER_DB_URL=postgresql://mirage_indexer:mirage_indexer@127.0.0.1:5432/mirage_indexer

# Read-only connection to the indexer DB (used by backend — never writes to indexer tables)
INDEXER_DB_RO_URL=postgresql://mirage_indexer_ro:mirage_indexer_ro@127.0.0.1:5432/mirage_indexer

# Backend-owned DB for registration, stats, reports, push, and similarity
BACKEND_DB_URL=postgresql://mirage_backend:mirage_backend@127.0.0.1:5432/mirage_backend

# ── Push Notifications ──────────────────────────────────────────────────

# Push notifications - set to true to enable Expo push for inbox events
# The backend push listener polls the indexer DB for new events.
# The backend also reads this to gate token registration API endpoints.
PUSH_NOTIFICATIONS_ENABLED=true

# Expo access token (optional) - for Enhanced Push Security in EAS dashboard
EXPO_ACCESS_TOKEN=

# Trending post push notifications - set to true to enable the trending poller.
TRENDING_PUSH_ENABLED=true

