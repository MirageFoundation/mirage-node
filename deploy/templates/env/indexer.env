# Enable or disable the blockchain indexer service (true/false)
INDEXER_ENABLED=true

# PostgreSQL connection URL for storing indexed blockchain data
INDEXER_DB_URL=postgresql://mirage:mirage@127.0.0.1:5432/mirage

# Maximum lookback period in days for indexing historical blocks (default: 7)
# Values greater than 7 are unlikely to work due to aggressive node pruning
INDEXER_MAX_LOOKBACK_DAYS=7

# ── Push Notifications ──────────────────────────────────────────────────

# Push notifications - set to true to enable Expo push for inbox events
# The indexer sends pushes when it indexes new replies/mentions/awards.
# The backend also reads this to gate token registration API endpoints.
PUSH_NOTIFICATIONS_ENABLED=false

# Expo access token (optional) - for Enhanced Push Security in EAS dashboard
EXPO_ACCESS_TOKEN=

