# =============================================================================
# SECRETS - API Keys and Tokens (NEVER commit actual values!)
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare Media Services (optional)
# Used for image and video uploads in the backend
# Get credentials from: Cloudflare Dashboard > Images/Stream
# -----------------------------------------------------------------------------

# Cloudflare account ID (found in dashboard URL or API settings)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with Images/Stream write permissions
CLOUDFLARE_API_TOKEN=

# Cloudflare Images account hash (for serving uploaded images)
CLOUDFLARE_ACCOUNT_HASH=

# Cloudflare Stream customer code (for video uploads)
CLOUDFLARE_STREAM_CUSTOMER_CODE=


# -----------------------------------------------------------------------------
# Bunny Media Services (optional)
# Used when MEDIA_PROVIDER=bunny. Images -> Bunny Storage + Optimizer pull zone;
# video -> Bunny Stream. Get credentials from the Bunny dashboard.
# -----------------------------------------------------------------------------

# Bunny Storage zone name + password (AccessKey) for image uploads
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=

# Bunny Storage region host (default: storage.bunnycdn.com; e.g. ny.storage.bunnycdn.com)
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# Pull zone host that serves the storage zone (e.g. myzone.b-cdn.net)
BUNNY_PULL_ZONE_HOST=

# Bunny Stream library id + API key for video uploads
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# Bunny Stream CDN host for the library (e.g. vz-xxxxxxxx.b-cdn.net)
BUNNY_STREAM_CDN_HOST=


# -----------------------------------------------------------------------------
# Telegram Alerts (optional)
# Used by alert scripts (optional)
# 1. Create a bot via @BotFather on Telegram
# 2. Add the bot to your alert group/channel
# 3. Get chat_id: curl https://api.telegram.org/bot<TOKEN>/getUpdates
# -----------------------------------------------------------------------------

# Bot token from @BotFather (format: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=

# Chat ID where alerts will be sent (use getUpdates API to find this)
TELEGRAM_CHAT_ID=


