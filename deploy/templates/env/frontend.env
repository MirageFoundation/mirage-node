# Which Mirage node the local dev server (web/frontend/run_frontend_local.sh)
# connects to. Empty = it asks. The shipped bundle is always built with
# VITE_API_BASE=/api, so this value has no effect on a deployed node; a URL here
# only misleads an operator into thinking their node talks to someone else's.
VITE_API_BASE=

# Public client-side API key for GIPHY (used by GIF picker in chat/posts).
# Read by the *backend* get_node_config and returned to the client at runtime.
# Get your API key from https://developers.giphy.com/
REACT_APP_GIPHY_API_KEY=YEDuQCmeTLIqvbYzUnA7QTILBOA8JbQO
#
# NOTE: VITE_* vars are baked into the JS bundle at Docker build time.
# Changing them here has no effect at runtime. To customize, rebuild the image.
# REACT_APP_GIPHY_API_KEY remains a backend runtime env name (not a Vite client var).

# App download banners (read by backend get_node_config at runtime)
ANDROID_BANNER_ENABLED=true
IOS_BANNER_ENABLED=true
