# =============================================================================
# SECRETS - API Keys and Tokens (NEVER commit actual values!)
# =============================================================================
# Copy this file to ~/.mirage/config/secrets.env and fill in your values.
# This file is separate from other env files to make secrets management easier.

# -----------------------------------------------------------------------------
# OpenAI / ChatGPT (optional)
# Used for AI-powered fraud analysis in referral and account review scripts
# Get your API key from: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Telegram Alerts (optional)
# Used by check_hermes_status.sh to send IBC/relayer alerts
# 1. Create a bot via @BotFather on Telegram
# 2. Add the bot to your alert group/channel
# 3. Get chat_id: curl https://api.telegram.org/bot<TOKEN>/getUpdates
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Cloudflare Media Services (optional)
# Used for image and video uploads in the backend
# Get credentials from: Cloudflare Dashboard > Images/Stream
# -----------------------------------------------------------------------------

# Account ID (found in dashboard URL or API settings)
CLOUDFLARE_ACCOUNT_ID=

# API token with Images/Stream write permissions
CLOUDFLARE_API_TOKEN=

# Images account hash (for serving uploaded images)
CLOUDFLARE_ACCOUNT_HASH=

# Stream customer code (for video uploads)
CLOUDFLARE_STREAM_CUSTOMER_CODE=
