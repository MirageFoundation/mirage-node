# Human-readable name for this node (displayed in block explorer and peer lists)
MONIKER=mirage-node

# Domain for HTTPS/TLS (leave empty for HTTP-only local deployments)
DOMAIN=

# Enable peer exchange protocol for automatic peer discovery (true/false)
PEX_ENABLED=true

# Note: Persistent peers are configured in persistent_peers.txt (one per line)

# Maximum number of incoming peer connections to accept
MAX_INBOUND_PEERS=40

# Maximum number of outgoing peer connections to initiate
MAX_OUTBOUND_PEERS=10

# IBC Relayer (Hermes) version to install (default: v1.10.4)
HERMES_VERSION=v1.10.4

# Note: Telegram alerts are configured in secrets.env (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID)
