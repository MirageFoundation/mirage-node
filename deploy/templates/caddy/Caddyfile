{
	order rate_limit before basicauth
	servers {
		# Real client IP from the edge in front of this node. The trusted-proxy
		# ranges + header are generated at startup into trusted-proxies.caddy by
		# deploy/refresh_edge_ips.py based on EDGE_PROVIDER (cloudflare | bunny |
		# both), so {client_ip} stays correct whether this node is behind
		# Cloudflare or Bunny. Default (cloudflare) preserves prior behavior.
		import trusted-proxies.caddy
	}
}

# Site address. ORIGIN_DOMAIN (e.g. origin.mirage.vote) is added at cutover so
# Caddy serves + auto-renews TLS for the origin hostname Bunny connects to. That
# hostname keeps pointing at this server's IP (HTTP-01 keeps working) even after
# the public domain's DNS moves to Bunny. Empty for non-edge nodes (renders as a
# harmless trailing token). Both names share the same handlers below.
${DOMAIN:-:80} ${ORIGIN_DOMAIN} {
	encode zstd gzip

	log {
		output file ${LOGS_DIR}/caddy/access.log {
			roll_size 100mb
			roll_keep_for 720h
		}
		format json {
			time_format iso8601
		}
	}

	# Maintenance mode: when /etc/caddy/.maintenance exists, serve upgrade page for ALL routes.
	# Created by entrypoint at startup, removed when backend is ready.
	@maintenance file {
		root /etc/caddy
		try_files .maintenance
	}
	handle @maintenance {
		header Cache-Control "no-store, max-age=0"
		header Pragma "no-cache"
		header Expires "0"

		# API and chain endpoints get JSON 503 during maintenance
		handle /api/* {
			header Content-Type "application/json"
			respond `{"error":"maintenance","message":"Upgrade in progress"}` 503
		}
		handle /chain/* {
			header Content-Type "application/json"
			respond `{"error":"maintenance","message":"Upgrade in progress"}` 503
		}
		# Everything else gets the HTML maintenance page
		handle {
			root * /etc/caddy
			rewrite * /maintenance.html
			header Content-Type "text/html; charset=utf-8"
			file_server {
				status 503
			}
		}
	}

	# Uniform media upload endpoint: allow large request bodies (video) and a
	# lighter rate limit than the generic API zone. Must precede @api.
	@upload {
		path /api/upload_media
	}
	handle @upload {
		request_body {
			# Kept above backend MEDIA_MAX_VIDEO_MB (1500MB) so the backend returns a
			# clean error instead of Caddy hard-cutting the stream. ~30-min 1080p video.
			max_size 1600MB
		}
		rate_limit {
			zone upload_limit {
				key {client_ip}
				events 4
				window 10s
			}
		}
		reverse_proxy 127.0.0.1:5000 {
			header_up CF-Connecting-IP {client_ip}
		}
	}

	@api {
		path /api/*
	}
	handle @api {
		# Dynamic API responses must never be cached by an edge/CDN (Bunny). Edge
		# Rules also bypass cache for /api/*, but set it at origin too (defense in
		# depth). The "?" only sets a default, so endpoints that intentionally
		# cache (e.g. the image proxy: public, max-age=600) keep their own value.
		header ?Cache-Control "no-store"
		rate_limit {
			zone api_limit {
				key {client_ip}
				events 50
				window 1s
			}
		}
		reverse_proxy 127.0.0.1:5000 {
			header_up CF-Connecting-IP {client_ip}
		}
	}

	# Locally-hosted media (MEDIA_PROVIDER=local): served from the node's disk.
	# Safe headers: never sniff, never render arbitrary types inline.
	@media {
		path /media/*
	}
	handle @media {
		root * ${MEDIA_LOCAL_DIR:-/root/.mirage/media}
		uri strip_prefix /media
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		header Content-Disposition "inline"
		file_server
	}

	# Chain RPC (CometBFT) - includes WebSocket at /chain/rpc/websocket
	handle /chain/rpc/* {
		# Unconditional, unlike the blocks above: CometBFT stamps some JSON-RPC
		# responses "public, max-age=86400", including live state like abci_info.
		# With a CDN in front, a conditional header lets that through and the edge
		# then publishes day-stale height and app version.
		header Cache-Control "no-store"
		rate_limit {
			zone chain_rpc_limit {
				key {client_ip}
				events 30
				window 1s
			}
		}
		uri strip_prefix /chain/rpc
		reverse_proxy 127.0.0.1:26657
	}

	# Chain REST (Cosmos SDK)
	handle /chain/rest/* {
		header ?Cache-Control "no-store"
		rate_limit {
			zone chain_rest_limit {
				key {client_ip}
				events 30
				window 1s
			}
		}
		uri strip_prefix /chain/rest
		reverse_proxy 127.0.0.1:1317
	}

	handle /.well-known/mirage/* {
		root * /root/.mirage/well-known
		uri strip_prefix /.well-known/mirage
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * /opt/mirage/web/frontend/build

		# Security headers (wallet origin)
		header {
			# strict-origin-when-cross-origin (not no-referrer): YouTube embeds
			# require a Referer and return Error 153 when it is stripped.
			# Cross-origin still only sends the origin, never path/query.
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			# All window.open calls pass noopener,noreferrer and nothing here talks to
			# a popup, so severing the opener relationship costs nothing.
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			# Enforcing, not report-only. It shipped report-only with no report-uri,
			# report-to or Reporting-Endpoints anywhere, so no violation was ever
			# collected and the "enforce after UAT soak" exit criterion could not be
			# reached — it was a no-op with a plan attached. img-src and media-src stay
			# permissive by decision: tightening them to the mediaPolicy.js allowlist
			# would break inline media from arbitrary hosts.
			# connect-src carries b-cdn.net because hls.js pulls Bunny manifests and
			# segments over XHR, which media-src does not cover. Cloudflare Stream is
			# not listed: it is fetched through the same-origin /api/stream_proxy.
			# CSP_UPGRADE_INSECURE carries the mixed-content upgrade directive, and
			# only when a domain is set. A node reached by IP serves :80 with no
			# cert, so upgrading would send the module script to https, where
			# nothing answers, and the app would not load at all. entrypoint.sh
			# fills it in and refuses to start a domain node that lost it.
			# script-src includes 'wasm-unsafe-eval' because every free-tier tx
			# (including signup) compiles argon2 WASM in /pow/worker.js.
			# 'self' alone makes WebAssembly.instantiate() throw CompileError
			# (blocked by CSP); the worker never hashes and the UI sits on
			# Preparing... until the 60s PoW timeout. This token allows WASM
			# compilation only — it does not allow JS eval.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.giphy.com https://*.b-cdn.net; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https://www.youtube.com https://youtube.com https://www.redgifs.com https://redgifs.com https://rumble.com https://www.rumble.com https://iframe.cloudflarestream.com https://*.cloudflarestream.com https://videodelivery.net; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'${CSP_UPGRADE_INSECURE}"
		}

		@aasa path /.well-known/apple-app-site-association
		header @aasa Content-Type "application/json"

		@wasm path *.wasm
		header @wasm Content-Type "application/wasm"

		@immutable path /static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# The PoW engine (argon2 wasm + worker). This was the one asset directory
		# with no policy here, and the CDN filled the gap with a 30-day default,
		# so the worker fix in v1.38.1 would not have reached a returning visitor
		# for a month. It is not fingerprinted the way /static/* is, so it has to
		# revalidate rather than be declared immutable. The bodies are ~78KB in
		# total and are only fetched when a transaction is signed.
		@pow path /pow/*
		header @pow Cache-Control "no-cache"

		@html path /
		header @html Cache-Control "no-cache"

		@spa_route not file
		header @spa_route Cache-Control "no-cache"

		# Deployed build marker, served without an extension: the CDN picks cache
		# policy from the file extension and ignores this no-store, which pinned
		# /version.txt to a weeks-old build string. Extensionless paths reach the
		# origin, so /version is the one that reports the deployed build. Declared
		# after @spa_route so no-store wins over the shell's no-cache.
		@version path /version /version.txt
		header @version Cache-Control "no-store"
		rewrite /version /version.txt

		# A fingerprinted asset that is gone must 404 rather than fall through to
		# the SPA shell below. Every deploy renames these files, so a browser
		# still running the previous build asks for names the origin no longer
		# has; answering 200 with index.html makes it reject a text/html module
		# ("disallowed MIME type") and the route never renders. It is also a
		# cacheable 200, so the CDN can pin an HTML body to a .js URL. route
		# rather than bare directives because the order here is the point.
		route {
			@missing_asset {
				path /static/*
				not file
			}
			respond @missing_asset 404

			try_files {path} /index.html
			file_server
		}
	}

	# Show maintenance page when backends are down (502/503)
	handle_errors {
		@rate_limited expression {err.status_code} == 429
		handle @rate_limited {
			handle /api/* {
				header Content-Type "application/json"
				respond `{"error":"rate_limited","message":"Too many requests. Please retry shortly."}` 429
			}
			handle /chain/* {
				header Content-Type "application/json"
				respond `{"error":"rate_limited","message":"Too many requests. Please retry shortly."}` 429
			}
			handle {
				header Content-Type "text/plain; charset=utf-8"
				respond "Too many requests. Please retry shortly." 429
			}
		}

		@maintenance_err expression {err.status_code} in [502, 503]
		handle @maintenance_err {
			header Cache-Control "no-store, max-age=0"
			header Pragma "no-cache"
			header Expires "0"

			# API and chain endpoints get JSON error
			handle /api/* {
				header Content-Type "application/json"
				respond `{"error":"unavailable","message":"Service temporarily unavailable"}` 503
			}
			handle /chain/* {
				header Content-Type "application/json"
				respond `{"error":"unavailable","message":"Service temporarily unavailable"}` 503
			}
			# Everything else gets the HTML maintenance page
			handle {
				root * /etc/caddy
				rewrite * /maintenance.html
				header Content-Type "text/html; charset=utf-8"
				file_server {
					status 503
				}
			}
		}
	}
}
