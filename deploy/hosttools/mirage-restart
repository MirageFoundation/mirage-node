#!/usr/bin/env bash
# One safety-checked whole-container restart.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: mirage-restart

Performs one whole-container restart. Refuses while the node is catching up
or while a governed halt/activation is in progress.

EOF
}

if [[ $# -gt 0 ]]; then
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
fi

if ! docker inspect mirage --format '{{.State.Running}}' 2>/dev/null | grep -qx true; then
  echo "ERROR: mirage container is not running" >&2
  exit 1
fi

if [[ -f /root/.mirage/upgrade/halt-detected.txt || -f /var/lib/mirage/update/activating ]]; then
  echo "ERROR: governed halt or activation is in progress; refusing restart" >&2
  exit 1
fi

status=$(curl -fsS --max-time 5 http://127.0.0.1:26657/status) || {
  echo "ERROR: local RPC is unavailable; refusing restart" >&2
  exit 1
}
catching=$(echo "$status" | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["sync_info"]["catching_up"])')
if [[ "$catching" == "True" || "$catching" == "true" ]]; then
  echo "ERROR: node is catching up; refusing restart" >&2
  exit 1
fi

plan=$(curl -fsS --max-time 5 http://127.0.0.1:1317/cosmos/upgrade/v1beta1/current_plan) || {
  echo "ERROR: local REST is unavailable; refusing restart" >&2
  exit 1
}
plan_name=$(echo "$plan" | python3 -c 'import json,sys; p=json.load(sys.stdin).get("plan") or {}; print(p.get("name") or "")')
if [[ -n "$plan_name" ]]; then
  plan_h=$(echo "$plan" | python3 -c 'import json,sys; p=json.load(sys.stdin).get("plan") or {}; print(int(p.get("height") or 0))')
  height=$(echo "$status" | python3 -c 'import json,sys; print(int(json.load(sys.stdin)["result"]["sync_info"]["latest_block_height"]))')
  remaining=$((plan_h - height))
  if (( remaining >= 0 && remaining <= 500 )); then
    echo "ERROR: upgrade plan $plan_name in $remaining blocks; refusing restart" >&2
    exit 1
  fi
fi

echo "==> Restarting mirage container"
exec docker restart mirage
