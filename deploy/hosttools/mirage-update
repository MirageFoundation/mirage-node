#!/usr/bin/env bash
# Manually check, stage and activate signed releases.
set -euo pipefail

HOME="${HOME:-/root}"
STATE_DIR=/var/lib/mirage/update
STATE_FILE="$STATE_DIR/state.json"
LOCK_DIR="$STATE_DIR"
MANIFEST_URL="${MIRAGE_MANIFEST_URL:-https://raw.githubusercontent.com/MirageFoundation/mirage-node/prod/release/manifest.json}"
NETWORK_URL="${MIRAGE_NETWORK_URL:-https://raw.githubusercontent.com/MirageFoundation/mirage-node/prod/release/network.json}"
PUBKEY=/usr/local/share/mirage/pubkey.pem
VERIFY=/usr/local/bin/mirage-verify
LAUNCH=/usr/local/bin/mirage-launch
SAFETY_BLOCKS="${UPGRADE_PREFLIGHT_SAFETY_BLOCKS:-500}"

show_help() {
  cat <<'EOF'
Usage: mirage-update [--status | --rollback]

  (no args)     check, verify, stage, and activate an ordinary release
  --status      show active/staged/prepared state without mutation
  --rollback    restore the previous image when the signed policy permits it

Governed chain upgrades are prepared with mirage-upgrade, not here.

Every release requires an explicit operator command. A prepared governed
upgrade activates automatically only after the node reaches its matching halt.

EOF
}

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  --tick|--rollback|--status|--activate-if-halted|"") ;;
  --refresh-hosttools)
    if [[ "${2:-}" != "--image" || -z "${3:-}" ]]; then
      echo "usage: mirage-update --refresh-hosttools --image ghcr.io/miragefoundation/mirage-node@sha256:..." >&2
      exit 2
    fi
    ;;
  *) echo "ERROR: unknown argument: $1" >&2; show_help >&2; exit 2 ;;
esac

mkdir -p "$STATE_DIR"

exec 9>"$LOCK_DIR/lock"
if ! flock -n 9; then
  echo "ERROR: updater already running" >&2
  exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fetch_verify() {
  local url="$1" dest="$2" nonce manifest_url signature_url base query
  nonce="$(date +%s%N)-$$-${RANDOM}"
  if [[ "$url" == *"?"* ]]; then
    base="${url%%\?*}"
    query="${url#*\?}"
    manifest_url="${base}?${query}&mirage_cache=${nonce}"
    signature_url="${base}.sig?${query}&mirage_cache=${nonce}"
  else
    manifest_url="${url}?mirage_cache=${nonce}"
    signature_url="${url}.sig?mirage_cache=${nonce}"
  fi
  curl -fsSL "$manifest_url" -o "$dest"
  curl -fsSL "$signature_url" -o "${dest}.sig"
  "$VERIFY" --manifest "$dest" --signature "${dest}.sig" --pubkey "$PUBKEY"
}

# Exit 0 when $1 >= $2, both vX.Y.Z.
version_at_least() {
  python3 - "$1" "$2" <<'PY'
import re, sys
def parse(v):
    if not re.fullmatch(r"v\d+\.\d+\.\d+", v):
        sys.exit(2)
    return tuple(int(p) for p in v[1:].split("."))
have, want = parse(sys.argv[1]), parse(sys.argv[2])
sys.exit(0 if have >= want else 1)
PY
}

# Restarts of the running validators reach RPC in about 35s, but an activation
# carrying a deploy migration takes longer, and calling slow "unhealthy" would
# roll back a release that was fine. Budget generously, and let a crashed or
# crash-looping container end the wait early so a real failure still rolls back
# promptly instead of sitting out the deadline.
wait_for_rpc() {
  local budget=900 elapsed=0 restarts_before restarts_now
  restarts_before=$(docker inspect -f '{{.RestartCount}}' mirage 2>/dev/null || echo 0)
  while (( elapsed < budget )); do
    if curl -fsS --max-time 2 http://127.0.0.1:26657/status >/dev/null 2>&1; then
      echo "RPC ready after ${elapsed}s"
      return 0
    fi
    if [[ "$(docker inspect -f '{{.State.Running}}' mirage 2>/dev/null || true)" != true \
       && "$(docker inspect -f '{{.State.Restarting}}' mirage 2>/dev/null || true)" != true ]]; then
      echo "ERROR: the mirage container is no longer running" >&2
      return 1
    fi
    restarts_now=$(docker inspect -f '{{.RestartCount}}' mirage 2>/dev/null || echo "$restarts_before")
    if (( restarts_now > restarts_before )); then
      echo "ERROR: the mirage container is restarting in a loop" >&2
      return 1
    fi
    if (( elapsed > 0 && elapsed % 60 == 0 )); then
      echo "still starting (${elapsed}s of ${budget}s)"
    fi
    sleep 3
    elapsed=$((elapsed + 3))
  done
  echo "ERROR: RPC did not become ready in ${budget}s" >&2
  return 1
}

# LCD is not published on the host (only 80/443/26656/26657 are). Query it
# inside the container so a live node is not mistaken for an uninitialized one.
query_local_rest() {
  docker exec mirage curl -fsS --max-time 5 "$1"
}

activate_staged() {
  if [[ ! -f "$STATE_FILE" ]]; then
    echo "ERROR: no updater state; nothing is staged" >&2
    exit 1
  fi
  staged=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("staged") or "")' "$STATE_FILE")
  if [[ -z "$staged" ]]; then
    echo "ERROR: no staged release" >&2
    exit 1
  fi
  activation=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("staged_activation") or "")' "$STATE_FILE")
  if [[ "$activation" == "upgrade-halt" ]]; then
    echo "ERROR: upgrade-halt releases cannot be activated manually; use the governed upgrade procedure" >&2
    exit 1
  fi
  if [[ "$activation" != "ordinary" ]]; then
    echo "ERROR: staged release has invalid activation policy '$activation'" >&2
    exit 1
  fi
  signed_height=$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1]))["height"]))' \
    "$HOME/.mirage/node/data/priv_validator_state.json")
  if status=$(curl -fsS --max-time 5 http://127.0.0.1:26657/status); then
    catching=$(echo "$status" | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["sync_info"]["catching_up"])')
    if [[ "$catching" != "False" && "$catching" != "false" ]]; then
      # Recreating the container mid-sync throws away a partial sync, which is
      # why this refuses. A node that has never signed has no partial state
      # worth keeping, and refusing there strands it on the release that
      # cannot finish syncing in the first place.
      if (( signed_height != 0 )); then
        echo "ERROR: node is catching up; refusing activation" >&2
        exit 1
      fi
      echo "node has never signed a block; activating its staged release rather than waiting for a sync that cannot finish"
    fi
  else
    # No RPC means the node is not running, so there is no partial sync to throw
    # away and nothing is gained by waiting: a node halted by a consensus fault
    # gets going again only by moving to a new image. This used to refuse for any
    # node with a signed height, which is every validator, so on 2026-08-20 the
    # nodes stopped by the supply-delta halt were the ones the updater would not
    # update. Recreating a container that is already down cannot lose anything.
    echo "local RPC is unavailable, so the node is down; activating its staged release"
  fi
  if plan=$(query_local_rest http://127.0.0.1:1317/cosmos/upgrade/v1beta1/current_plan); then
    plan_name=$(echo "$plan" | python3 -c 'import json,sys; p=json.load(sys.stdin).get("plan") or {}; print(p.get("name") or "")')
    plan_h=$(echo "$plan" | python3 -c 'import json,sys; p=json.load(sys.stdin).get("plan") or {}; print(p.get("height") or "0")')
    if [[ -n "$plan_name" ]]; then
      if [[ -z "${status:-}" ]]; then
        echo "ERROR: upgrade plan $plan_name is set but local RPC is down; refusing activation" >&2
        exit 1
      fi
      height=$(echo "$status" | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["sync_info"]["latest_block_height"])')
      remaining=$((plan_h - height))
      if (( remaining >= 0 && remaining <= SAFETY_BLOCKS )); then
        echo "ERROR: upgrade plan $plan_name in $remaining blocks; refusing ordinary activation" >&2
        exit 1
      fi
    fi
  else
    # Same reasoning as the RPC branch above: a node that is down cannot answer,
    # and refusing to update it leaves it down. Staging already refuses to put an
    # ordinary release over an armed governed upgrade, so the halt this check
    # protects cannot be crossed unnoticed by taking this path.
    echo "local REST is unavailable, so a nearby governed halt cannot be checked; activating its staged release"
  fi
  # A release is not required to be reached one version at a time. Deploy
  # migrations are applied by discovering everything this node has not run yet,
  # so a node that missed several releases applies all of their migrations on the
  # first boot of the new image. Demanding an intermediate release would strand
  # such a node permanently: only the newest manifest is ever published, so the
  # release it was told to install first cannot be fetched.
  local manifest manifest_image
  manifest="$HOME/.mirage/env/release-manifest.json"
  if [[ ! -f "$manifest" ]]; then
    echo "ERROR: staged release manifest missing: $manifest" >&2
    exit 1
  fi
  manifest_image=$(json_field "$manifest" image)
  if [[ "$manifest_image" != "$staged" ]]; then
    echo "ERROR: staged image $staged does not match release manifest $manifest_image" >&2
    exit 1
  fi
  current=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("active") or "")' "$STATE_FILE")
  staged_rollback_safe=$(python3 -c 'import json,sys; print(bool(json.load(open(sys.argv[1])).get("staged_rollback_safe")))' "$STATE_FILE")
  if ! "$LAUNCH" --image "$staged" || ! wait_for_rpc; then
    echo "ERROR: staged image failed to become healthy" >&2
    if [[ "$staged_rollback_safe" == "True" && -n "$current" ]]; then
      echo "attempting signed-policy-safe rollback to $current" >&2
      if "$LAUNCH" --image "$current" && wait_for_rpc; then
        echo "ERROR: restored previous image; staged release remains available for retry" >&2
        exit 1
      fi
      echo "ERROR: previous image also failed to become healthy" >&2
    fi
    python3 - "$STATE_FILE" "$staged" "$current" <<'PY'
import json, os, sys
path, staged, current = sys.argv[1:4]
state = json.load(open(path))
state["previous"] = current
state["active"] = staged
state["active_activation"] = state.get("staged_activation") or ""
state["active_rollback_safe"] = bool(state.get("staged_rollback_safe"))
state["active_consensus_breaking"] = bool(state.get("staged_consensus_breaking"))
state["staged"] = ""
state["staged_activation"] = ""
state["staged_rollback_safe"] = False
state["staged_consensus_breaking"] = False
tmp = path + ".tmp"
open(tmp, "w").write(json.dumps(state, indent=2) + "\n")
os.replace(tmp, path)
PY
    exit 1
  fi
  echo "installing host tools from $staged after successful activation"
  install_hosttools_from_image "$staged"
  python3 - "$STATE_FILE" "$staged" <<'PY'
import json, os, sys
path, staged = sys.argv[1], sys.argv[2]
state = json.load(open(path))
state["previous"] = state.get("active") or ""
state["active"] = staged
state["active_activation"] = state.get("staged_activation") or ""
state["active_rollback_safe"] = bool(state.get("staged_rollback_safe"))
state["active_consensus_breaking"] = bool(state.get("staged_consensus_breaking"))
state["staged"] = ""
state["staged_activation"] = ""
state["staged_rollback_safe"] = False
state["staged_consensus_breaking"] = False
tmp = path + ".tmp"
open(tmp, "w").write(json.dumps(state, indent=2) + "\n")
os.replace(tmp, path)
PY
  echo "activated $staged"
}

json_field() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$1" "$2"
}

canonical_hash() {
  python3 - "$1" <<'PY'
import hashlib, json, sys
obj = json.load(open(sys.argv[1]))
payload = json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
print(hashlib.sha256(payload).hexdigest())
PY
}

install_network_manifest() {
  local source="$1" peers
  peers=$(python3 -c 'import json,sys; print(",".join(json.load(open(sys.argv[1]))["persistent_peers"]))' "$source")
  python3 - "$HOME/.mirage/env/node.env" "$HOME/.mirage/node/config/config.toml" "$peers" <<'PY'
import os, re, sys
env_path, config_path, peers = sys.argv[1:4]

def replace(path, pattern, replacement):
    if not os.path.isfile(path):
        raise SystemExit(f"required peer configuration missing: {path}")
    text = open(path, encoding="utf-8").read()
    updated, count = re.subn(pattern, lambda _: replacement, text, count=1, flags=re.M)
    if count != 1:
        raise SystemExit(f"persistent peers setting missing or duplicated in {path}")
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(updated)
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)

replace(env_path, r"^PERSISTENT_PEERS=.*$", f"PERSISTENT_PEERS={peers}")
replace(config_path, r'^persistent_peers\s*=.*$', f'persistent_peers = "{peers}"')
PY
  install -m 0644 "$source" "$HOME/.mirage/env/network-manifest.json.tmp"
  mv "$HOME/.mirage/env/network-manifest.json.tmp" "$HOME/.mirage/env/network-manifest.json"
}

pubkey_fingerprint() {
  openssl pkey -pubin -in "$1" -outform DER | tail -c 32 | od -An -v -tx1 | tr -d ' \n'
}

disable_automatic_release_fetch() {
  systemctl disable --now mirage-update.timer >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/mirage-update.service /etc/systemd/system/mirage-update.timer
  systemctl daemon-reload
}

install_hosttools_from_image() {
  local image="$1" staging="$tmp/hosttools" image_fp host_fp tool
  mkdir -p "$staging"
  docker run --rm -v "$staging:/out" --entrypoint /bin/bash "$image" -lc \
    'cp -a /opt/mirage/deploy/hosttools/. /out/ && cp /opt/mirage/deploy/release_verify.py /out/'
  image_fp=$(pubkey_fingerprint "$staging/pubkey.pem")
  host_fp=$(pubkey_fingerprint "$PUBKEY")
  if [[ "$image_fp" != "$host_fp" ]]; then
    echo "ERROR: staged image pubkey $image_fp does not match host trust anchor $host_fp" >&2
    exit 1
  fi
  for tool in mirage-verify mirage-launch mirage-status mirage-update mirage-upgrade mirage-domain mirage-enroll mirage-backup mirage-restore mirage-logs mirage-restart; do
    install -m 0755 "$staging/$tool" "/usr/local/bin/$tool"
  done
  install -m 0755 "$staging/prune_mirage_images.sh" /usr/local/bin/prune_mirage_images.sh
  install -m 0755 "$staging/mirage-weekly-restart.sh" /usr/local/sbin/mirage-weekly-restart.sh
  install -m 0644 "$staging/release_verify.py" /usr/local/share/mirage/release_verify.py
  for tool in mirage-enroll.service mirage-enroll.timer mirage-upgrade-activate.service mirage-upgrade-activate.timer; do
    install -m 0644 "$staging/systemd/$tool" "/etc/systemd/system/$tool"
  done
  disable_automatic_release_fetch
  systemctl enable --now mirage-upgrade-activate.timer >/dev/null 2>&1 || true
}

tick() {
  mkdir -p "$HOME/.mirage/env" "$HOME/.mirage/well-known"
  fetch_verify "$MANIFEST_URL" "$tmp/manifest.json"
  fetch_verify "$NETWORK_URL" "$tmp/network.json"
  image=$(json_field "$tmp/manifest.json" image)
  release_id=$(json_field "$tmp/manifest.json" release_id)
  version=$(json_field "$tmp/manifest.json" version)
  min_release=$(json_field "$tmp/network.json" min_release)
  generation=$(json_field "$tmp/network.json" generation)
  activation=$(json_field "$tmp/manifest.json" activation)
  rollback_safe=$(json_field "$tmp/manifest.json" rollback_safe)
  consensus_breaking=$(json_field "$tmp/manifest.json" consensus_breaking)
  if ! version_at_least "$version" "$min_release"; then
    echo "ERROR: release $version is below the network's min_release $min_release" >&2
    exit 1
  fi
  last_id=0
  last_gen=0
  if [[ -f "$STATE_FILE" ]]; then
    last_id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("last_release_id") or 0)' "$STATE_FILE")
    last_gen=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("last_network_generation") or 0)' "$STATE_FILE")
    # A signature stays valid forever, so an old manifest replayed at us is the
    # attack this rejects.
    if (( generation < last_gen )); then
      echo "ERROR: network manifest generation $generation is older than the last seen $last_gen" >&2
      exit 1
    fi
    if (( generation == last_gen )) && [[ -f "$HOME/.mirage/env/network-manifest.json" ]]; then
      old_hash=$(canonical_hash "$HOME/.mirage/env/network-manifest.json")
      new_hash=$(canonical_hash "$tmp/network.json")
      if [[ "$old_hash" != "$new_hash" ]]; then
        echo "ERROR: network manifest changed without increasing generation $generation" >&2
        exit 1
      fi
    fi
  fi
  if (( generation > last_gen )); then
    install_network_manifest "$tmp/network.json"
    install -m 0644 "$tmp/network.json.sig" "$HOME/.mirage/env/network-manifest.json.sig.tmp"
    mv "$HOME/.mirage/env/network-manifest.json.sig.tmp" "$HOME/.mirage/env/network-manifest.json.sig"
    install -m 0644 "$tmp/network.json" "$HOME/.mirage/well-known/network.json"
    install -m 0644 "$tmp/network.json.sig" "$HOME/.mirage/well-known/network.json.sig"
    python3 - "$STATE_FILE" "$generation" <<'PY'
import json, os, sys
path, generation = sys.argv[1], int(sys.argv[2])
state = json.load(open(path)) if os.path.isfile(path) else {}
state["last_network_generation"] = generation
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".tmp"
open(tmp, "w").write(json.dumps(state, indent=2) + "\n")
os.replace(tmp, path)
PY
    echo "installed network manifest generation $generation"
  fi
  if (( release_id < last_id )); then
    echo "ERROR: release manifest id $release_id is older than the last seen $last_id" >&2
    exit 1
  fi
  if (( release_id == last_id )); then
    if [[ -f "$HOME/.mirage/env/release-manifest.json" ]]; then
      old_hash=$(canonical_hash "$HOME/.mirage/env/release-manifest.json")
      new_hash=$(canonical_hash "$tmp/manifest.json")
      if [[ "$old_hash" != "$new_hash" ]]; then
        echo "ERROR: release manifest changed without increasing release_id $release_id" >&2
        exit 1
      fi
    fi
    echo "no newer release (last_release_id=$last_id)"
    return 0
  fi
  # An armed governed upgrade owns the next container recreate. Staging an
  # unrelated ordinary release over it would repoint "staged", leave the prepared
  # digest unreferenced for the image pruner, and strand the halt with
  # "prepared image is not present locally". activate_staged already refuses
  # ordinary activation near a plan; refuse the staging too. prepared.json only
  # exists while an upgrade is pending, so the release lands on the next manual
  # update after the halt is crossed.
  if [[ -f "$HOME/.mirage/upgrade/prepared.json" && "$activation" == "ordinary" ]]; then
    echo "governed upgrade $(json_field "$HOME/.mirage/upgrade/prepared.json" upgrade_name) is armed for height $(json_field "$HOME/.mirage/upgrade/prepared.json" plan_height); not staging ordinary release $version over it"
    return 0
  fi
  docker pull "$image"
  digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$image")
  if [[ "$digest" != "$image" && "$digest" != *"${image#*@}"* ]]; then
    echo "ERROR: pulled RepoDigest $digest does not match manifest $image" >&2
    exit 1
  fi
  python3 - "$STATE_FILE" "$image" "$release_id" "$generation" "$activation" "$rollback_safe" "$consensus_breaking" <<'PY'
import json, os, sys
path, image, rid, gen, activation, rollback_safe, consensus_breaking = sys.argv[1:8]
state = {}
if os.path.isfile(path):
    state = json.load(open(path))
state["staged"] = image
state["last_release_id"] = int(rid)
state["last_network_generation"] = int(gen)
state["staged_activation"] = activation
state["staged_rollback_safe"] = rollback_safe == "True"
state["staged_consensus_breaking"] = consensus_breaking == "True"
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".tmp"
open(tmp, "w").write(json.dumps(state, indent=2) + "\n")
os.replace(tmp, path)
PY
  install -m 0644 "$tmp/manifest.json" "$HOME/.mirage/env/release-manifest.json.tmp"
  mv "$HOME/.mirage/env/release-manifest.json.tmp" "$HOME/.mirage/env/release-manifest.json"
  install -m 0644 "$tmp/manifest.json.sig" "$HOME/.mirage/env/release-manifest.json.sig.tmp"
  mv "$HOME/.mirage/env/release-manifest.json.sig.tmp" "$HOME/.mirage/env/release-manifest.json.sig"
  install -m 0644 "$tmp/manifest.json" "$HOME/.mirage/well-known/manifest.json"
  install -m 0644 "$tmp/manifest.json.sig" "$HOME/.mirage/well-known/manifest.json.sig"
  echo "staged $image activation=$activation (host tools install on activation)"
  if [[ "$activation" == "upgrade-halt" ]]; then
    echo "governance-linked release staged; run mirage-upgrade after its on-chain plan passes"
  fi
}

update_now() {
  # Always refresh policy before activation so the operator cannot restart onto
  # an image that was superseded before the command began.
  tick
  staged=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("staged") or "")' "$STATE_FILE")
  if [[ -z "$staged" ]]; then
    echo "already up to date"
    return 0
  fi
  activate_staged
}

rollback() {
  if [[ ! -f "$STATE_FILE" ]]; then
    echo "ERROR: no updater state; nothing to roll back to" >&2
    exit 1
  fi
  previous=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("previous") or "")' "$STATE_FILE")
  if [[ -z "$previous" ]]; then
    echo "ERROR: no previous image recorded" >&2
    exit 1
  fi
  rollback_safe=$(python3 -c 'import json,sys; print(bool(json.load(open(sys.argv[1])).get("active_rollback_safe")))' "$STATE_FILE")
  consensus_breaking=$(python3 -c 'import json,sys; print(bool(json.load(open(sys.argv[1])).get("active_consensus_breaking")))' "$STATE_FILE")
  if [[ "$rollback_safe" != "True" || "$consensus_breaking" == "True" ]]; then
    echo "ERROR: the active release manifest does not permit rollback" >&2
    exit 1
  fi
  "$LAUNCH" --image "$previous"
  python3 - "$STATE_FILE" "$previous" <<'PY'
import json, os, sys
path, previous = sys.argv[1], sys.argv[2]
state = json.load(open(path))
rolled_back_from = state.get("active") or ""
rolled_back_activation = state.get("active_activation") or ""
rolled_back_safe = bool(state.get("active_rollback_safe"))
rolled_back_consensus = bool(state.get("active_consensus_breaking"))
state["active"] = previous
state["active_activation"] = ""
state["active_rollback_safe"] = False
state["active_consensus_breaking"] = False
state["previous"] = ""
state["staged"] = rolled_back_from
state["staged_activation"] = rolled_back_activation
state["staged_rollback_safe"] = rolled_back_safe
state["staged_consensus_breaking"] = rolled_back_consensus
tmp = path + ".tmp"
open(tmp, "w").write(json.dumps(state, indent=2) + "\n")
os.replace(tmp, path)
PY
  echo "rolled back to $previous"
}

# Host tools verify each manifest with the copy of the verifier already on this
# machine, so a node whose verifier predates a change to the manifest format
# rejects every new release and cannot update its way out. This takes the tools
# from an image the operator names, which is the one step that breaks that loop.
refresh_hosttools() {
  local image="$1"
  if [[ ! "$image" =~ ^ghcr\.io/miragefoundation/mirage-node@sha256:[0-9a-f]{64}$ ]]; then
    echo "ERROR: --image must be a digest-pinned ghcr.io/miragefoundation/mirage-node reference" >&2
    exit 2
  fi
  docker pull "$image"
  install_hosttools_from_image "$image"
  echo "host tools refreshed from $image"
}

show_status() {
  python3 - "$STATE_FILE" <<'PY'
import json, os, sys
path = sys.argv[1]
state = json.load(open(path)) if os.path.isfile(path) else {}
print("active:", state.get("active") or "(none)")
print("staged:", state.get("staged") or "(none)")
print("staged_activation:", state.get("staged_activation") or "(none)")
print("rollback_safe:", state.get("active_rollback_safe"))
print("consensus_breaking:", state.get("active_consensus_breaking"))
PY
  if [[ -f "$HOME/.mirage/upgrade/prepared.json" ]]; then
    python3 - "$HOME/.mirage/upgrade/prepared.json" <<'PY'
import json, sys
p = json.load(open(sys.argv[1]))
print("prepared_upgrade:", p.get("upgrade_name"))
print("prepared_height:", p.get("plan_height") or "(pending governance)")
print("prepared_image:", p.get("image"))
print("prepared_at:", p.get("prepared_at"))
PY
  else
    echo "prepared_upgrade: (none)"
  fi
  if [[ -f "$HOME/.mirage/upgrade/halt-detected.txt" ]]; then
    echo "halt_detected: yes"
    cat "$HOME/.mirage/upgrade/halt-detected.txt"
  else
    echo "halt_detected: no"
  fi
  if [[ -f "$STATE_DIR/activating" ]]; then
    echo "activation_ready: activating"
  elif [[ -f "$HOME/.mirage/node/data/upgrade-info.json" && -f "$HOME/.mirage/upgrade/prepared.json" ]]; then
    echo "activation_ready: halt marker present"
  else
    echo "activation_ready: waiting for governed halt"
  fi
}

activate_if_halted() {
  local prepared="$HOME/.mirage/upgrade/prepared.json"
  if [[ ! -f "$prepared" ]]; then
    exit 0
  fi
  local name height image
  name=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["upgrade_name"])' "$prepared")
  height=$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1]))["plan_height"]))' "$prepared")
  image=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["image"])' "$prepared")
  local marker="$HOME/.mirage/node/data/upgrade-info.json"
  if [[ ! -f "$marker" ]]; then
    exit 0
  fi
  local marker_values marker_name marker_height
  marker_values=$(python3 - "$marker" <<'PY'
import json, sys
info = json.load(open(sys.argv[1]))
name = info.get("name") or ""
height = int(info.get("height") or 0)
if not name or height <= 0:
    raise SystemExit(1)
print(name)
print(height)
PY
) || exit 0
  marker_name=$(printf '%s\n' "$marker_values" | awk 'NR == 1')
  marker_height=$(printf '%s\n' "$marker_values" | awk 'NR == 2')
  if [[ "$marker_name" != "$name" ]]; then
    exit 0
  fi
  if (( height > 0 && marker_height != height )); then
    exit 0
  fi
  if (( height == 0 )); then
    height=$marker_height
    echo "prepared before governance; matched $name to halt marker at height $height"
  fi
  local pv="$HOME/.mirage/node/data/priv_validator_state.json"
  if [[ ! -f "$pv" ]]; then
    echo "ERROR: priv_validator_state.json missing; refusing activation" >&2
    exit 1
  fi
  local signed_height
  signed_height=$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1]))["height"]))' "$pv")
  # The chain writes the halt marker when it stops at the upgrade height, so the
  # marker checked above is already proof that this node reached the halt. The
  # signed height is a weaker second witness that only exists for a validator in
  # the active set: a jailed or not-yet-registered node never signs that block,
  # so demanding equality strands exactly the nodes that need the swap most.
  # Refuse only when signing is past the halt, which means the marker is stale.
  if (( signed_height > height )); then
    echo "halt $height is behind signed height $signed_height; clearing the stale prepared upgrade"
    rm -f "$prepared" "$STATE_DIR/prepared.json"
    exit 0
  fi
  if (( signed_height != height )); then
    echo "this node did not sign the halt block (signed height $signed_height); the halt marker at $height is authoritative"
  fi
  local digest want_sha
  digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$image") || {
    echo "ERROR: prepared image $image is not present locally; refusing activation" >&2
    exit 1
  }
  want_sha=${image#*@}
  if [[ "$digest" != *"$want_sha"* ]]; then
    echo "ERROR: local image $digest does not match prepared $image" >&2
    exit 1
  fi
  echo "activating" > "$STATE_DIR/activating"
  echo "==> Verified governed halt for $name at $height; recreating container from $image"
  if ! "$LAUNCH" --image "$image"; then
    rm -f "$STATE_DIR/activating"
    echo "ERROR: failed to launch prepared image; node remains halted for operator action" >&2
    exit 1
  fi
  if ! wait_for_rpc; then
    rm -f "$STATE_DIR/activating"
    echo "ERROR: prepared image did not become healthy; node remains halted" >&2
    exit 1
  fi
  local plan_name
  plan_name=$(query_local_rest http://127.0.0.1:1317/cosmos/upgrade/v1beta1/current_plan \
    | python3 -c 'import json,sys; p=json.load(sys.stdin).get("plan") or {}; print(p.get("name") or "")')
  if [[ -n "$plan_name" ]]; then
    rm -f "$STATE_DIR/activating"
    echo "ERROR: upgrade plan $plan_name is still set after activation" >&2
    exit 1
  fi
  local now_h
  now_h=$(curl -fsS --max-time 5 http://127.0.0.1:26657/status \
    | python3 -c 'import json,sys; print(int(json.load(sys.stdin)["result"]["sync_info"]["latest_block_height"]))')
  if (( now_h <= height )); then
    rm -f "$STATE_DIR/activating"
    echo "ERROR: height $now_h has not advanced past upgrade height $height" >&2
    exit 1
  fi
  install_hosttools_from_image "$image"
  python3 - "$STATE_FILE" "$image" <<'PY'
import json, os, sys
path, image = sys.argv[1], sys.argv[2]
state = json.load(open(path)) if os.path.isfile(path) else {}
state["previous"] = state.get("active") or ""
state["active"] = image
state["active_activation"] = "upgrade-halt"
state["active_rollback_safe"] = False
state["active_consensus_breaking"] = True
state["staged"] = ""
state["staged_activation"] = ""
state["staged_rollback_safe"] = False
state["staged_consensus_breaking"] = False
tmp = path + ".tmp"
open(tmp, "w").write(json.dumps(state, indent=2) + "\n")
os.replace(tmp, path)
PY
  # The chain leaves upgrade-info.json in place after the upgrade, so leaving
  # prepared.json behind would make the 30s activation timer re-match this halt
  # and fail every tick forever.
  rm -f "$HOME/.mirage/upgrade/halt-detected.txt" "$STATE_DIR/activating" \
    "$prepared" "$STATE_DIR/prepared.json"
  echo "activated prepared upgrade $name; chain is at height $now_h"
}

case "${1:-}" in
  --tick) tick ;;
  --rollback) rollback ;;
  --status) show_status ;;
  --activate-if-halted) activate_if_halted ;;
  --refresh-hosttools)
    refresh_hosttools "$3"
    ;;
  "") update_now ;;
  *) echo "ERROR: unknown argument: $1" >&2; show_help >&2; exit 2 ;;
esac
