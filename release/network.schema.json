{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Mirage network manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "generation",
        "issued_at",
        "expires_at",
        "chain_id",
        "genesis_sha256",
        "rpc",
        "rest",
        "api",
        "persistent_peers",
        "min_release",
        "activation_balance_umirage",
        "self_delegation_umirage",
        "min_liquid_umirage"
    ],
    "properties": {
        "generation": {
            "type": "integer",
            "minimum": 1
        },
        "issued_at": {
            "type": "string",
            "format": "date-time"
        },
        "expires_at": {
            "type": "string",
            "format": "date-time"
        },
        "chain_id": {
            "type": "string",
            "const": "mirage-1"
        },
        "genesis_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "rpc": {
            "type": "array",
            "minItems": 2,
            "items": {
                "type": "string",
                "minLength": 8
            }
        },
        "rest": {
            "type": "array",
            "minItems": 2,
            "items": {
                "type": "string",
                "minLength": 8
            }
        },
        "api": {
            "type": "array",
            "minItems": 2,
            "items": {
                "type": "string",
                "minLength": 8
            }
        },
        "persistent_peers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}@.+:26656$"
            }
        },
        "min_release": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "activation_balance_umirage": {
            "type": "string",
            "pattern": "^[1-9][0-9]+$"
        },
        "self_delegation_umirage": {
            "type": "string",
            "pattern": "^[1-9][0-9]+$"
        },
        "min_liquid_umirage": {
            "type": "string",
            "pattern": "^[1-9][0-9]+$"
        }
    }
}