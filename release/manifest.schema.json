{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Mirage release manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "release_id",
        "commit",
        "image",
        "activation",
        "upgrade_name",
        "rollback_safe",
        "consensus_breaking"
    ],
    "properties": {
        "version": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "release_id": {
            "type": "integer",
            "minimum": 1
        },
        "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "image": {
            "type": "string",
            "pattern": "^ghcr\\.io/miragefoundation/mirage-node@sha256:[0-9a-f]{64}$"
        },
        "activation": {
            "type": "string",
            "enum": [
                "ordinary",
                "upgrade-halt"
            ]
        },
        "upgrade_name": {
            "type": "string"
        },
        "rollback_safe": {
            "type": "boolean"
        },
        "consensus_breaking": {
            "type": "boolean"
        }
    }
}
